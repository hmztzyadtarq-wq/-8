// الصق ده في Firebase ← Firestore Database ← Rules ← Publish
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // الأدمن = أي حساب ليه مستند في مجموعة admins (اسم المستند = الـ UID)
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, delete: if isAdmin();
    }

    // الموقع بيقرا دول، والأدمن بس هو اللي يعدّل
    match /products/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /branches/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /offers/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}   { allow read: if true; allow write: if isAdmin(); }

    // العميل: يسجّل نفسه، ويعدّل اسمه وعناوينه ومفضلته بس.
    // النقاط والمشتريات والخصم الخاص والإحصائيات: الأدمن بس.
    match /users/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'createdAt', 'refBy', 'addresses', 'favs'])
                    && (!('refBy' in request.resource.data) || request.resource.data.refBy is string);
      allow read:   if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'addresses', 'favs', 'refCode'])
                    && (!('refCode' in resource.data) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['refCode']))
                    && request.resource.data.get('addresses', []).size() <= 5
                    && request.resource.data.get('favs', []).size() <= 100);
      allow delete: if isAdmin();
    }

    // أكواد الدعوة: أي عميل مسجّل يعمل كود لنفسه مرة واحدة، ويتحقق من كود بالاسم (من غير ما يشوف الباقي)
    match /refs/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // أكواد الخصم الخاصة بعميل واحد: العميل يقرا بتاعته بس، والأدمن بس هو اللي يعمل ويعدّل
    match /coupons/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // العميل يعمل طلب باسمه بس ويتابع طلباته، والأدمن يدير الكل
    match /orders/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'جديدة'
                    && request.resource.data.total is number && request.resource.data.total >= 0
                    && !request.resource.data.keys().hasAny(['stockDone', 'ptsSpentDone', 'statsDone', 'ptsEarnedN', 'ptsTaken'])
                    && (request.resource.data.get('pointsUsed', 0) == 0
                        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                            && request.resource.data.pointsUsed <= get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('points', 0)));
      allow read:   if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
